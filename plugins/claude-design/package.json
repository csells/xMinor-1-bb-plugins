{
  "name": "bb-plugin-claude-design",
  "version": "0.1.1",
  "type": "module",
  "description": "Claude Design inside bb: project links, bb's browser beside the chat, and Send to Claude comments handed to an agent.",
  "license": "MIT",
  "author": "Foma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/claude-design"
  },
  "keywords": [
    "bb-plugin",
    "claude-design",
    "design",
    "comments",
    "mcp"
  ],
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.104"
  },
  "bb": {
    "name": "Claude Design",
