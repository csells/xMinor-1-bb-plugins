    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "files": [
    "dist",
    "server.ts",
    "contract.ts",
    "app.tsx",
    "icon.svg",
